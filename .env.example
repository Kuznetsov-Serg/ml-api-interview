# Application
APP_NAME="ML Prediction API"
ENV=development

# Model
MODEL_TYPE=type_pickle
MODEL_PATH_PICKLE=./data/models/model_pickle.pkl
MODEL_PATH_JSON=./data/models/model_json.json

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ml_db    # pragma: allowlist secret

# Redis
IS_REDIS=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Server
HOST=127.0.0.1
PORT=8000
