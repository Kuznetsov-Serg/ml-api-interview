# Application
APP_NAME=ML Prediction API
ENV=development

# Model
MODEL_TYPE=type_pickle
MODEL_PATH_PICKLE=./data/models/model_pickle.pkl
MODEL_PATH_JSON=./data/models/model_json.json

# Database
DATABASE_URL=postgresql+asyncpg://ml_user:ml_pass@db:5432/ml_db

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600

# Server
HOST=0.0.0.0
PORT=8000